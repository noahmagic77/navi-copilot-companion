{
  "name": "navi-copilot-companion",
  "displayName": "NAVI Copilot Companion",
  "description": "Private local-first VS Code companion with a fairy guide and local prompt insights.",
  "version": "0.5.2",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Chat",
    "Other"
  ],
  "main": "./dist/src/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "chatParticipants": [
      {
        "id": "navi.chat",
        "name": "navi",
        "fullName": "NAVI",
        "description": "A local-first chat companion.",
        "isSticky": false,
        "commands": [
          {
            "name": "explain",
            "description": "Explain a topic"
          },
          {
            "name": "summarize",
            "description": "Summarize a topic"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "navi",
          "title": "NAVI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "navi": [
        {
          "id": "navi.companion",
          "name": "NAVI Companion",
          "type": "webview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {"command":"navi.showSpeech","title":"NAVI: Show Speech Bubble / Sprechblase anzeigen"},
      {"command":"navi.hideSpeech","title":"NAVI: Hide Speech Bubble / Sprechblase ausschalten"},
      {"command":"navi.talkToFairy","title":"NAVI: Talk to Fairy / Mit NAVI sprechen"},
      {
        "command": "navi.flyToPosition",
        "title": "NAVI: Fly to Position / Zu Position fliegen"
      },
      {
        "command": "navi.cancelFlight",
        "title": "NAVI: Cancel Target Flight / Zielflug abbrechen"
      },
      {
        "command": "navi.showOverlay",
        "title": "NAVI: Show Foreground Fairy / Vordergrund-Fee anzeigen"
      },
      {
        "command": "navi.hideOverlay",
        "title": "NAVI: Hide Foreground Fairy / Vordergrund-Fee ausblenden"
      },
      {
        "command": "navi.openCompanion",
        "title": "NAVI: Open Companion / Ansicht \u00f6ffnen"
      },
      {
        "command": "navi.showFairy",
        "title": "NAVI: Show Fairy / Fee anzeigen"
      },
      {
        "command": "navi.showStatus",
        "title": "NAVI: Show Status"
      },
      {
        "command": "navi.openDataFolder",
        "title": "NAVI: Open Local Data Folder"
      },
      {
        "command": "navi.clearHistory",
        "title": "NAVI: Clear Local History"
      },
      {
        "command": "navi.checkPrompt",
        "title": "NAVI: Check Prompt"
      },
      {
        "command": "navi.rebuildIndex",
        "title": "NAVI: Rebuild Analytics Index"
      },
      {
        "command": "navi.exportAnalytics",
        "title": "NAVI: Export Sanitized Analytics"
      },
      {
        "command": "navi.clearAnalytics",
        "title": "NAVI: Delete Sanitized Analytics"
      },
      {
        "command": "navi.importOtel",
        "title": "NAVI: Import OTel Metrics JSONL (Manual)"
      }
    ],
    "configuration": {
      "title": "NAVI",
      "properties": {
        "navi.bubble.enabled": {"type":"boolean","default":true,"description":"Show transient speech bubbles beside NAVI for interaction events and short excerpts of NAVI's own chat replies."},
        "navi.sound.enabled": {
          "type": "boolean", "default": false,
          "description": "Play original local fairy voice-like cues for greetings, discoveries, hints and celebration. No microphone or cloud service."
        },
        "navi.sound.volume": {
          "type": "integer", "default": 30, "minimum": 0, "maximum": 100,
          "description": "Fairy sound volume from 0 (silent) to 100."
        },
        "navi.fairy.animationEnabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Enable NAVI's 110 coordinated movements and reactions, including ten additional greetings. Pauses while hidden."
        },
        "navi.fairy.respectReducedMotion": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Pause NAVI animations when the operating system requests reduced motion."
        },
        "navi.history.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Explicit opt-in: persist NAVI's own full prompts and responses locally. Never accesses Copilot's private history."
        },
        "navi.history.maxEntries": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "maximum": 5000,
          "description": "Maximum stored opt-in NAVI chat exchanges."
        },
        "navi.analytics.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Explicit opt-in: save only sanitized NAVI rule codes and metrics in local JSONL and optional SQLite index."
        },
        "navi.overlay.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Show the local native foreground fairy on supported Windows x64 systems. The fairy hides when its VS Code window is inactive. No external service."
        },
        "navi.fairy.powerMode": {
          "type": "string",
          "enum": [
            "balanced",
            "eco"
          ],
          "default": "balanced",
          "scope": "machine",
          "enumDescriptions": [
            "Balanced: up to 30 FPS while active, 15 FPS while hovering.",
            "Eco: fewer sparkles and lower active frame rates."
          ],
          "description": "Resource budget for the foreground fairy and the embedded preview."
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "compile": "node scripts/native-motion-fixture.cjs --check && node scripts/generate-audio.cjs --check && tsc -p .",
    "check": "node scripts/native-motion-fixture.cjs --check && node scripts/generate-audio.cjs --check && tsc -p . --noEmit",
    "test": "npm run compile && node --test dist/test/*.test.js",
    "package": "npm run build:overlay && npm test && npm run verify:overlay && vsce package --no-dependencies",
    "build:overlay": "node scripts/build-overlay.cjs",
    "verify:overlay": "node scripts/verify-overlay.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.8.3"
  },
  "icon": "media/logo.png",
  "publisher": "navi-labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/noahmagic77/navi-copilot-companion.git"
  }
}
